# ============================================================================
# PassWall 的 .config 片段 —— 追加到你的固件仓库的 .config 里
#
# 用法：
#   cat integration/passwall.config >> .config
#   然后正常 make defconfig / make
#
# 这个文件**故意不含** CONFIG_TARGET_* 行 —— target 由你的固件仓库自己决定，
# 这里的包选择跨架构通用（都是 all 或纯 C / Go 包）。
#
# 只列「比默认多出来或需要改的东西」。defconfig 会补全内核、base 包、
# LuCI 等其余默认项。
# ============================================================================

# ------------------------------------------------------------------ PassWall
CONFIG_PACKAGE_luci-app-passwall=y

# 关键：固件编译必须开这个，它 select 了透明代理需要的内核模块：
#   kmod-nft-tproxy / kmod-nft-socket / kmod-nft-nat
#   dnsmasq-full（带 ipset/nftset 支持）、ipt2socks、nftables
#
# 注意：vendor/build.sh 编 ipk 时把这项设成 n 是对的（SDK 不出镜像，
# 内核模块由设备自带），但固件里必须是 y —— 否则装上了 PassWall 也没法转发流量。
CONFIG_PACKAGE_luci-app-passwall_Nftables_Transparent_Proxy=y

# 24.10 默认用 firewall4（nftables），iptables 那套不需要
CONFIG_PACKAGE_luci-app-passwall_Iptables_Transparent_Proxy=n

# dnsmasq-full 与基础版 dnsmasq 会争抢同一批文件（/etc/init.d/dnsmasq、
# /usr/sbin/dnsmasq 等），镜像构建时 opkg 直接报 check_data_file_clashes。
# 上面那个 Nftables_Transparent_Proxy 会 select dnsmasq-full，但镜像默认又选了
# 基础版 dnsmasq，两者同时存在就冲突。必须显式关掉基础版。
#
# 这个报错很坑：它出现在「Configuring luci-app-passwall」之后，opkg 只给
# Error 255，冲突详情要往前翻很多行才能看到，很容易误判成 PassWall 的问题。
CONFIG_PACKAGE_dnsmasq=n
CONFIG_PACKAGE_dnsmasq-full=y

# ------------------------------------------------------------------ 协议开关
# 全部关掉，改为直接选包。
# 原因：这些 INCLUDE_* 开关在 kconfig 里会引发循环依赖
#   luci-app-passwall → sing-box-tiny → sing-box → (selected by) luci-app-passwall
# 导致 make defconfig 放弃处理、把它们打回 not set。
# PassWall 运行时只认 /usr/bin 下有没有对应二进制，直接选包效果一样。
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Brook=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Haproxy=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Hysteria=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_NaiveProxy=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Libev_Client=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Libev_Server=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Client=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Server=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_ShadowsocksR_Libev_Client=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_ShadowsocksR_Libev_Server=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Simple_Obfs=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SingBox=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Trojan_GO=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Trojan_Plus=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_tuic_client=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Geodata=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Plugin=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray_Plugin=n

# ------------------------------------------------------------------ 协议本体
# shadowsocks-c（包名沿用 shadowsocks-libev-ss-*，见 vendor/shadowsocks-c）
CONFIG_PACKAGE_shadowsocks-libev-ss-local=y
CONFIG_PACKAGE_shadowsocks-libev-ss-redir=y
CONFIG_PACKAGE_shadowsocks-libev-ss-server=y
# ss-tunnel / ss-manager 用不到，不装（省 ~120K）
CONFIG_PACKAGE_shadowsocks-libev-ss-tunnel=n
CONFIG_PACKAGE_shadowsocks-libev-ss-manager=n

# hysteria v1（与 util_hysteria.lua 的配置格式配套）
CONFIG_PACKAGE_hysteria=y

# ------------------------------------------------------------------ 运行时依赖
# 这些包在官方 feed 里已经没有了，由本仓库或 passwall_packages feed 提供
CONFIG_PACKAGE_dns2tcp=y
CONFIG_PACKAGE_chinadns-ng=y
CONFIG_PACKAGE_dns2socks=y
CONFIG_PACKAGE_microsocks=y
CONFIG_PACKAGE_tcping=y

# ------------------------------------------------------------------ LuCI
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-compat=y

# 中文界面：本仓库的 po/zh_Hans 是坏的（Windows 提交把符号链接压成了文本文件），
# 编出来是空包，所以不选。界面走英文。
# 如果以后修好了翻译，把下面这行的注释去掉。
# CONFIG_PACKAGE_luci-i18n-passwall-zh-cn=y
